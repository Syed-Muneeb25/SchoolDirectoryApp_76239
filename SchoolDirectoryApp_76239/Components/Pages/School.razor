@page "/schools"
@rendermode InteractiveServer
@inject SchoolService Service
@inject FavouritesService Favourites
@using SchoolModel = SchoolDirectoryApp_76239.Models.School

<PageTitle>School Directory</PageTitle>

<!-- Header Section -->
<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary">
    <div>
        <h1 class="fw-bold text-white mb-1">Explore Schools</h1>
        <p class="text-muted mb-0">Browse and filter institutions from the directory registry.</p>
    </div>
    <button class="btn btn-primary px-4" @onclick="LoadSchools">
        Refresh Data
    </button>
</div>

<!-- Search & Filter Control Bar -->
<div class="card p-3 mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-lg-5">
            <input @bind="Search"
                   @bind:event="oninput"
                   class="form-control"
                   placeholder="Search school by name..."
                   style="--bs-secondary-color: #cbd5e1;"/>
        </div>

        <div class="col-lg-3 col-md-6">
            <select class="modern-select" @bind="sortOrder">
                <option value="asc">Name: A → Z</option>
                <option value="desc">Name: Z → A</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-3">
            <div class="form-check form-switch custom-switch">
                <input class="form-check-input darker-border-checkbox" type="checkbox" role="switch"
                       id="favOnly" @bind="showFavouritesOnly" />
                <label class="form-check-label text-light ms-2" for="favOnly">Favourites only</label>
            </div>
        </div>

        <div class="col-lg-2 col-md-3">
            <div class="text-muted text-end small">
                Total: <strong>@(schools?.Count ?? 0)</strong>
            </div>
        </div>
    </div>
</div>

@if (error)
{
    <div class="alert alert-danger border-0 bg-danger text-white rounded-3 shadow-sm" role="alert">
        Unable to retrieve school data from the server.
    </div>
}
else if (schools == null)
{
    <div class="text-center text-muted py-5 my-5">
        <div class="spinner-border text-success mb-3" role="status"></div>
        <p class="h5 text-light">Loading directories...</p>
    </div>
}
else
{
    var filtered = FilteredSchools.ToList();

    <!-- Statistics Overview Chips -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card panel p-3">
                <div class="text-muted small">Total Schools</div>
                <div class="h4 fw-bold text-white mb-0">@schools.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card panel p-3">
                <div class="text-muted small">Showing Now</div>
                <div class="h4 fw-bold text-success mb-0">@filtered.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card panel p-3">
                <div class="text-muted small">Favourites</div>
                <div class="h4 fw-bold text-warning mb-0">@Favourites.Count</div>
            </div>
        </div>
    </div>

    <!-- Modern Card Grid Layout -->
    
<!-- Modern Card Grid Layout -->
<div class="row g-4">
    @foreach (var school in filtered)
    {
        <SchoolCard School="school"
                    IsFavourite="@Favourites.IsFavourite(school.SchoolId)"
                    OnSelect="ShowDetails"
                    OnToggleFavourite="ToggleFavourite" />
    }

    @if (!filtered.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="card panel p-5">
                <p class="h5 text-light mb-0">
                    No schools found matching your search or filter.
                </p>
            </div>
        </div>
    }
</div>

}

@* Pop-up with the details of the selected school *@
@if (selectedSchool != null)
{
    <SchoolDetail School="selectedSchool" OnClose="CloseDetails" />
}

@code {
    private List<SchoolModel>? schools;          
    private SchoolModel? selectedSchool;        
    private bool error;                         
    private string Search { get; set; } = string.Empty;  
    private string sortOrder = "asc";           
    private bool showFavouritesOnly;            

    private IEnumerable<SchoolModel> FilteredSchools
    {
        get
        {
            var result = schools!.Where(s =>
               (s.SchoolName ?? "").Contains(Search, StringComparison.OrdinalIgnoreCase));

            if (showFavouritesOnly)
            {
                result = result.Where(s => Favourites.IsFavourite(s.SchoolId));
            }

            return sortOrder == "asc"
                ? result.OrderBy(s => s.SchoolName, StringComparer.OrdinalIgnoreCase)
                : result.OrderByDescending(s => s.SchoolName, StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSchools();
    }

    private async Task LoadSchools()
    {
        error = false;
        schools = null;         
        selectedSchool = null;

        try
        {
            schools = await Service.GetSchoolsAsync();
        }
        catch
        {
            error = true;       
        }
    }

    private void ShowDetails(SchoolModel school)
    {
        selectedSchool = school;
    }

    private void CloseDetails()
    {
        selectedSchool = null;
    }

    private void ToggleFavourite(SchoolModel school)
    {
        Favourites.Toggle(school.SchoolId);
    }
}