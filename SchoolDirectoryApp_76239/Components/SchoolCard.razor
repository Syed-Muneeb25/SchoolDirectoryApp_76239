
@using SchoolDirectoryApp_76239.Models

<div class="col-xl-4 col-md-6">
    <div class="card h-100 p-3 transition-card">
        <div class="card-body d-flex flex-column">

            <div class="d-flex justify-content-between align-items-start mb-3">
                <h4 class="h5 fw-bold text-white mb-0">
                    @School.SchoolName
                </h4>

                <button class="btn btn-sm text-warning p-0 border-0 bg-transparent ms-2"
                        title="@(IsFavourite ? "Remove from favourites" : "Add to favourites")"
                        @onclick="() => OnToggleFavourite.InvokeAsync(School)">
                    <i class="bi @(IsFavourite ? "bi-star-fill" : "bi-star") fs-5"></i>
                </button>
            </div>

            <p class="text-muted small mb-3 flex-grow-1">
                <i class="bi bi-geo-alt me-1 text-success"></i>
                @(string.IsNullOrEmpty(School.Address) ? "No address specified" : School.Address)
            </p>

            <button class="btn btn-primary w-100 btn-sm mt-auto"
                    @onclick="() => OnSelect.InvokeAsync(School)">
                View Details
            </button>

        </div>
    </div>
</div>

@code {
    [Parameter]
    public School School { get; set; } = new();

    [Parameter]
    public bool IsFavourite { get; set; }

    [Parameter]
    public EventCallback<School> OnSelect { get; set; }

    [Parameter]
    public EventCallback<School> OnToggleFavourite { get; set; }
}
